AWS_REGION=""

DATABASE_NAME=""
DATABASE_USER=""
DATABASE_HOST=""
DATABASE_PORT=""
DATABASE_PASSWORD=""
DATABASE_SECRET_ARN=""
APP_ENV="dev" # dev, staging, prod
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080"
# Leave these empty to use the X-User-Id fallback in local dev.
# Set both to enable Cognito JWT verification in staging/production.
COGNITO_REGION="us-east-1"
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
# Optional for Swagger UI login in /docs.
# Set either a prefix or full domain:
#   prefix example: pantry-pilot-auth -> https://pantry-pilot-auth.auth.<region>.amazoncognito.com
#   full domain example: https://auth.example.com
COGNITO_HOSTED_UI_DOMAIN_PREFIX=""
COGNITO_HOSTED_UI_DOMAIN=""

# OpenCode AI — used for AI-generated pantry coverage and shopping gaps.
# Uses the OpenAI-compatible endpoint. The /v1/chat/completions path
# is appended automatically by the openai package.
OPENCODE_BASE_URL="https://opencode.ai/zen/go/v1"
OPENCODE_MODEL="deepseek-v4-flash"
OPENCODE_API_KEY="sk-..."