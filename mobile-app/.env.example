# ─── Cognito / Auth ───────────────────────────────────────────────────────────
# Obtained from Terraform outputs after `terraform apply` in infra/.
# Pass these at build time via --dart-define-from-file=.env
# or individually with --dart-define=KEY=value.

COGNITO_CLIENT_ID=<app_client_id from Terraform output>
COGNITO_USER_POOL_ID=<user_pool_id from Terraform output>
COGNITO_REGION=us-east-1
COGNITO_HOSTED_UI_DOMAIN_PREFIX=pantry-pilot-auth

# ─── API ──────────────────────────────────────────────────────────────────────
# Override the backend base URL (no trailing slash).
# Defaults: Android emulator → http://10.0.2.2:8000, all others → http://localhost:8000

# API_BASE_URL=https://api.yourapp.example.com

# Override the fallback user ID used when Cognito auth is not configured.
# Defaults to: mobile-user-1

# API_USER_ID=mobile-user-1
